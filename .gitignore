# Generated by host/install.js with machine-specific paths.
host/run-host.cmd
host/run-host.sh
host/com.dsx.shell_host.json
host/com.dsx.shell_host.firefox.json

# Build output, one folder per version: dist/<version>/dsx-<version>-setup.exe (bundles the Node.js
# runtime) and dist/<version>/dsx-<version>-firefox-unsigned.zip.
dist/

# Saved copies of the DeepSeek page, kept only as a reference for its styling. They hold the
# page's own code and whatever was on screen when it was saved, so they never go in the repository.
/DeepSeek - *
/*_files/

# Python bytecode from the end-to-end test.
__pycache__/
*.pyc
