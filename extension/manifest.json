{
  "manifest_version": 3,
  "name": "DeepSeek Web Agent",
  "version": "0.13.1",
  "description": "Gives the DeepSeek web chat tools to read and edit files and run commands on your computer.",
  "key": "",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["nativeMessaging", "storage"],
  "host_permissions": ["https://chat.deepseek.com/*"],
  "background": { "service_worker": "background.js", "scripts": ["lib/update-check.js", "lib/agent-pool.js", "lib/agent-registry.js", "background.js"] },
  "browser_specific_settings": {
    "gecko": {
      "id": "deepseek-web-agent@itsdaxi",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    },
    "gecko_android": { "strict_min_version": "142.0" }
  },
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["lib/protocol.js", "lib/context-usage.js", "lib/stream-filter.js", "lib/chip-hider.js", "page-hook.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["lib/slash-match.js", "lib/format-tokens.js", "lib/chat-stats.js", "lib/terminal-core.js", "lib/agent-view.js", "lib/todo.js", "lib/projects.js", "cards.js", "menus.js", "page-controls.js", "think-collapse.js", "think-tokens.js", "slash-commands.js", "terminal.js", "sidebar-projects.js", "content.js"],
      "css": ["page.css"],
      "run_at": "document_start"
    }
  ]
}
