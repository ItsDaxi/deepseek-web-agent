{
  "manifest_version": 3,
  "name": "DeepSeek Web Agent",
  "version": "0.2.2",
  "description": "Gives the DeepSeek web chat tools to read and edit files and run commands on your computer.",
  "key": "",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["nativeMessaging", "storage"],
  "host_permissions": ["https://chat.deepseek.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["lib/protocol.js", "lib/context-usage.js", "lib/stream-filter.js", "page-hook.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["lib/slash-match.js", "lib/context-usage.js", "cards.js", "page-controls.js", "evil-awakening.js", "think-collapse.js", "slash-commands.js", "content.js"],
      "css": ["page.css", "logos.css", "evil.css"],
      "run_at": "document_start"
    }
  ]
}
